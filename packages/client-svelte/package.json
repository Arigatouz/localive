{
  "name": "@localive/svelte",
  "version": "0.2.5",
  "description": "Svelte 5 bindings for Localive's in-app translation editor.",
  "license": "MIT",
  "author": "Ali Gamal <aga@luftborn.com> (https://github.com/Arigatouz)",
  "homepage": "https://localive.vercel.app/guides/svelte/",
  "bugs": "https://github.com/Arigatouz/localive/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arigatouz/localive.git",
    "directory": "packages/client-svelte"
  },
  "keywords": [
    "i18n",
    "svelte",
    "translation",
    "localization",
    "live-editing",
    "localive",
    "developer-tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.spec.*",
    "README.md"
  ],
  "scripts": {
    "build": "svelte-package --input src --output dist --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@localive/core": "^0.2.5",
    "svelte": ">=5.0.0"
  },
  "devDependencies": {
    "@localive/core": "^0.2.5",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@testing-library/svelte": "^5.2.0",
    "jsdom": "^25.0.1",
    "svelte": "^5.0.0",
    "@sveltejs/package": "3.0.3"
  },
  "nx": {
    "tags": [
      "scope:client:svelte",
      "type:lib"
    ]
  }
}
