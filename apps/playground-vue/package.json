{
  "name": "playground-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@localive/adapter-vue-i18n": "*",
    "@localive/core": "*",
    "@localive/vite": "*",
    "@localive/vue": "*",
    "vue": "^3.5.46",
    "vue-i18n": "^11.4.23"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/language-core": "^3.3.14",
    "typescript": "~6.0.3",
    "vite": "^8.3.8"
  },
  "nx": {
    "tags": ["scope:app", "type:app"],
    "targets": {
      "typecheck": {
        "executor": "nx:run-commands",
        "dependsOn": ["^typecheck"],
        "options": {
          "cwd": "apps/playground-vue",
          "command": "tsc --project tsconfig.json --noEmit"
        },
        "outputs": []
      }
    }
  }
}
